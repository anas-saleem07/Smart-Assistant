@implements IDisposable

@code {
    [Parameter] public EventCallback Refresh { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly PeriodicTimer timer = new(TimeSpan.FromSeconds(20));
    public CancellationToken Token => lifetime.Token;

    protected override void OnInitialized() => _ = RunAsync();

    private async Task RunAsync()
    {
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                await InvokeAsync(RefreshIfActiveAsync);
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private Task RefreshIfActiveAsync() =>
        !lifetime.IsCancellationRequested && SmartAssistant.App.ForegroundState.IsActive
            ? Refresh.InvokeAsync() : Task.CompletedTask;

    public void Dispose()
    {
        lifetime.Cancel();
        timer.Dispose();
    }
}
